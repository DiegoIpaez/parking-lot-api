generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ParkingSpaceStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
  MAINTENANCE
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum ParkingSessionStatus {
  ACTIVE
  COMPLETED
}

model Sector {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parkingSpaces ParkingSpace[]

  @@map("sectors")
}

model ParkingSpace {
  id        Int                @id @default(autoincrement())
  number    Int
  sectorId  Int
  status    ParkingSpaceStatus @default(AVAILABLE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  parkingSessions ParkingSession[]

  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@map("parking_spaces")
}

model VehicleType {
  id            Int      @id @default(autoincrement())
  name          String
  ratePerMinute Decimal  @db.Decimal(10, 2)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicles Vehicle[]

  @@map("vehicle_types")
}

model VehicleBrand {
  id        Int      @id @default(autoincrement())
  name      String
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicleModels VehicleModel[]

  @@map("vehicle_brands")
}

model VehicleModel {
  id             Int      @id @default(autoincrement())
  name           String
  vehicleBrandId Int
  deleted        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vehicles Vehicle[]

  vehicleBrand VehicleBrand @relation(fields: [vehicleBrandId], references: [id], onDelete: Cascade)

  @@map("vehicle_models")
}

model Vehicle {
  id             Int      @id @default(autoincrement())
  licensePlate   String   @unique
  vehicleTypeId  Int
  vehicleModelId Int
  deleted        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parkingSessions ParkingSession[]

  vehicleModel VehicleModel @relation(fields: [vehicleModelId], references: [id], onDelete: Restrict)
  vehicleType  VehicleType  @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)

  @@map("vehicles")
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  role      UserRole @default(OPERATOR)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkInSessions  ParkingSession[] @relation("check_in_user")
  checkOutSessions ParkingSession[] @relation("check_out_user")

  @@map("users")
}

model ParkingSession {
  id              Int                  @id @default(autoincrement())
  vehicleId       Int
  parkingSpaceId  Int
  checkInUserId   Int
  checkOutUserId  Int?
  checkInTime     DateTime             @default(now())
  checkOutTime    DateTime?
  durationMinutes Int?
  totalAmount     Decimal?             @db.Decimal(10, 2)
  status          ParkingSessionStatus @default(ACTIVE)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  parkingSpace ParkingSpace @relation(fields: [parkingSpaceId], references: [id], onDelete: Restrict)
  checkInUser  User         @relation("check_in_user", fields: [checkInUserId], references: [id], onDelete: Restrict)
  checkOutUser User?        @relation("check_out_user", fields: [checkOutUserId], references: [id], onDelete: Restrict)

  @@map("parking_sessions")
}
